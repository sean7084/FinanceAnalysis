# Coverage configuration for FinanceAnalysis
# Run with: coverage run manage.py test && coverage report

[run]
source = apps
omit =
    */migrations/*
    */tests.py
    */tests/*
    */__pycache__/*
    */management/*
branch = True

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
