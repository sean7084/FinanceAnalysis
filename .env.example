# Copy this file to .env for local development.
# PowerShell:
#   Copy-Item .env.example .env
# Bash:
#   cp .env.example .env
#
# Every variable below is listed with the default the code actually uses, so the file
# works unchanged apart from the credentials and hosts marked "replace". Optional
# tuning keys are included explicitly rather than commented out: docs/reference/env.md
# is generated by scanning this file for uncommented KEY= lines, so commenting a key
# out would make it undiscoverable again.
#
# Regenerate the reference after changing this file or config/settings/:
#   python manage.py export_documentation_facts

# GENERAL
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_DEBUG=True
DJANGO_READ_DOT_ENV_FILE=True

# DATABASE
# ------------------------------------------------------------------------------
# Replace 192.168.31.8 if your PostgreSQL host differs.
DATABASE_URL=postgres://finance_analysis:finance_analysis@192.168.31.8:5432/finance_analysis

# CACHE / CHANNELS
# ------------------------------------------------------------------------------
# Replace 192.168.31.8 if your Redis host differs.
#
# This server uses a Redis ACL user, so the username is required -- the
# password-only form redis://:password@host:6379/1 and the default-user form
# redis://default:password@host:6379/1 both fail with WRONGPASS. If the password
# contains any of : / @ # ? % or a space, percent-encode it (: becomes %3A), or
# urlparse will misparse the host and push the credential into the path.
REDIS_URL=redis://finance_analysis:finance_analysis@192.168.31.8:6379/1

# CELERY
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://finance_analysis:finance_analysis@192.168.31.8:6379/0

# Not read by Django settings -- CELERY_RESULT_BACKEND is derived from
# CELERY_BROKER_URL in config/settings/base.py. scripts/_native_env.* exports it for
# the native launchers, so it is kept here for those.
CELERY_RESULT_BACKEND=redis://finance_analysis:finance_analysis@192.168.31.8:6379/0

# Comma-separated queues for a worker to consume. Declared queues are ops, backtest,
# train-lightgbm and train-lstm, with ops as CELERY_TASK_DEFAULT_QUEUE.
#
# scripts/run_celery_worker.sh defaults to "ops" because it is meant to be started
# once per queue group. compose/local/django/start-celeryworker defaults to all four
# because the Compose stack runs a single worker, which would otherwise never pick up
# a backtest or a retrain.
CELERY_WORKER_QUEUES=ops,backtest,train-lightgbm,train-lstm

# DATA PROVIDER
# ------------------------------------------------------------------------------
TUSHARE_TOKEN=replace-with-your-tushare-token

# DATA GOVERNANCE
# ------------------------------------------------------------------------------
# Nothing is requested or retained before this date, apart from the deliberate
# indicator warm-up exceptions documented in TECHNICAL_GUIDE.md.
HISTORICAL_DATA_FLOOR=2010-01-01
CAPITAL_FLOW_DAILY_SYNC_LOOKBACK_DAYS=20

# MACRO
# ------------------------------------------------------------------------------
MACRO_SYNC_PRIMARY_PROVIDER=tushare
MACRO_SYNC_FALLBACK_PROVIDER=akshare
MACRO_SYNC_PROVIDER_SLEEP_SECONDS=0.2
MACRO_YIELD_BACKFILL_WINDOW_MONTHS=36
MACRO_YIELD_BACKFILL_MAX_RETRIES=3
MACRO_YIELD_BACKFILL_RETRY_SLEEP_SECONDS=65.0
MACRO_YIELD_BACKFILL_CALL_SLEEP_SECONDS=31.0

# NEWS / SENTIMENT BACKFILL
# ------------------------------------------------------------------------------
NEWS_BACKFILL_ENABLED=True
NEWS_BACKFILL_PROVIDER=tushare_major
NEWS_BACKFILL_CHUNK_DAYS=31
NEWS_BACKFILL_FLOOR=2021-04-15 00:00:00
# 0 means no per-provider cap.
NEWS_BACKFILL_LIMIT_PER_PROVIDER=0

# BACKTEST
# ------------------------------------------------------------------------------
# How long a RUNNING backtest run can sit with no progress before considered orphaned.
BACKTEST_STALE_TASK_MAX_AGE_SECONDS=2400

# When True, the Django-rendered SPA shell points its <script> tags at the
# Vite dev server (http://localhost:5173/static/@vite/client etc.) so HMR keeps
# working while the page itself is served by Django on :8000. When False,
# django-vite reads frontend/dist/.vite/manifest.json and emits hashed
# /static/ URLs served by WhiteNoise. Defaults to DJANGO_DEBUG.
DJANGO_VITE_DEV_MODE=True
DJANGO_VITE_DEV_SERVER_HOST=localhost
DJANGO_VITE_DEV_SERVER_PORT=5173

# EMAIL
# ------------------------------------------------------------------------------
# Both backends default to the console backend, so mail is printed to stdout rather
# than sent. Switch EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend and
# fill in the host credentials to send for real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@financeanalysis.com
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ALERTING
# ------------------------------------------------------------------------------
ALERTS_ENABLE_SMS=False
SMS_WEBHOOK_URL=
# Comma-separated recipients for triggered alert rules that have the "email"
# channel enabled. Alert rules are no longer owned by a user, so there is
# nowhere else to take an address from.
ALERT_NOTIFY_EMAILS=

# MODEL ARTIFACT STORE
# ------------------------------------------------------------------------------
# Where trained model artifacts (LightGBM pickles, LSTM .pt, ensemble JSON) live.
# `local` (default) keeps them on the filesystem under the repo root -- the historical
# behaviour, and what CI uses. `s3` mirrors them to an S3-compatible object store
# (MinIO on the NAS) with the repo root as a local cache; object keys are the
# BASE_DIR-relative artifact_path already stored in the registry. See
# apps/prediction/artifact_store.py and docs/how-to/local-setup.md.
ARTIFACT_STORE_BACKEND=local
# ARTIFACT_LOCAL_CACHE_ROOT defaults to the repo root; override only to cache elsewhere.
# The S3 keys below are read only when ARTIFACT_STORE_BACKEND=s3. The endpoint is LAN-only
# (MinIO on the NAS); the access/secret keys are secrets -- they stay here in .env
# (gitignored) and in the NAS secrets inventory, never in the repo.
ARTIFACT_S3_ENDPOINT_URL=http://192.168.31.8:9000
ARTIFACT_S3_BUCKET=finance-analysis-artifacts
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ADDRESSING_STYLE=path

# DASHBOARD PERFORMANCE
# ------------------------------------------------------------------------------
# The dashboard stocks payload is served from a Redis cache shared across
# processes, and the nightly `prewarm-dashboard-stocks-cache` beat entry fills it
# so the first request of the day does not rebuild the payload. The cache key
# includes the factor date, so a new trading day invalidates on its own. The
# payload itself no longer runs model inference: candidate ranking reads stored
# prediction rows, so a cold cache costs a query, not a GPU.
DASHBOARD_STOCKS_CACHE_SECONDS=86400
# TTL for /dashboard/stocks/summary/, which folds the SPA's seven dashboard
# calls into one. Short, because signal and alert events arrive during a
# session. One shared key: with no authentication, the alert count is global.
DASHBOARD_SUMMARY_CACHE_SECONDS=60
# TTL for cached backtest `trades` / `comparison_curve` payloads. Both are
# immutable once a run is terminal and the key includes status and updated_at,
# so this is a ceiling rather than a staleness window.
BACKTEST_PAYLOAD_CACHE_SECONDS=3600
# How far back the dashboard indicator board scans for each asset's newest
# indicator row. The query must bound the range in plain timestamp terms: the
# `timestamp__date` transform cannot use the
# (asset, indicator_type, timestamp) index, so an unbounded lookup sorts every
# historical indicator row for every asset on the page. 60 days is wider than
# the staleness of any (asset, indicator_type) pair in the universe, so the
# window returns the same rows the unbounded query would.
DASHBOARD_INDICATOR_LOOKBACK_DAYS=60
# Per-asset, per-date lock TTL for the background prediction-generation jobs the
# prediction detail views queue when no stored row exists. A polling dashboard
# would otherwise stack universe-sized jobs on the same gap.
PREDICTION_GENERATION_LOCK_SECONDS=120
# Prediction completeness reconciliation. Beat never replays a missed occurrence
# with its original target date, and a universe sweep that runs out of its time
# budget leaves a date with a few rows rather than none, so "the task ran" is not
# evidence that the rows exist. This pass looks back over open trading dates and
# writes what is missing.
PREDICTION_RECONCILE_LOOKBACK_TRADING_DAYS=5
# 20 assets per hourly run repairs 480 rows a day against an effective universe in
# the thousands, so gaps persist for days. 250 per run covers the universe inside
# a trading day, which is what makes "read stored rows" a reliable contract rather
# than a cache-hit-rate gamble. Cost is a longer task, bounded by the worker's own
# time limit -- not a request the user waits on.
PREDICTION_RECONCILE_MAX_ASSETS_PER_RUN=250

# --- ETF rotation: live simulated book ---------------------------------------
# Notional capital the live ledger sizes its holdings against. The strategy
# targets a percentage weight, not a share count, so shares are only written
# when this is positive. 0 restores the old shares=NULL / pnl=NULL behaviour.
ETF_SIM_CAPITAL_BASE=1000000

# --- ETF rotation: LSTM capacity ---------------------------------------------
# These were literals in train_lstm's signature until P21. Defaults reproduce the
# old behaviour; raise hidden size / epochs only when a pretraining run is fast
# enough that the extra wall-clock buys a measurable IC, not a bigger model.
ETF_LSTM_SEQUENCE_LENGTH=20
ETF_LSTM_HIDDEN_SIZE=64
ETF_LSTM_NUM_LAYERS=2
ETF_LSTM_DROPOUT=0.2
ETF_LSTM_EPOCHS=50
ETF_LSTM_BATCH_SIZE=256
ETF_LSTM_LEARNING_RATE=0.001
ETF_LSTM_PATIENCE=5
# LightGBM thread count. The engine was pinned to 4 on a 16-core host; the default
# is now min(16, cpu_count - 2) so a sensitivity grid does not idle the machine.
ETF_LGB_NUM_THREADS=14

# --- ETF rotation: arms of the shadow book -----------------------------------
# JSON list of {arm, model_type, model_version}. Each arm is a separate ledger key;
# one arm failing on a missing artifact does not stop the others. Empty means the
# single-arm ETF_ML_SHADOW_MODEL path below is used.
ETF_ML_SHADOW_ARMS=[]

# --- ETF rotation: ML rematch (shadow book) ----------------------------------
# Empty means no shadow signal. Set to LIGHTGBM / LSTM / ENSEMBLE only after a
# candidate has passed the Phase 10 gate; the task is fail-closed when no active
# ModelVersion exists.
ETF_ML_SHADOW_MODEL=

# --- ETF rotation: forward-track drift monitor -------------------------------
# 0 means no reference: the monthly report is descriptive and makes no drift
# claim. Tolerances are absolute deviations; the closed-trade floor stops a
# handful of trades in one regime from being read as evidence.
ETF_LIVE_REFERENCE_BACKTEST_ID=0
ETF_LIVE_DRIFT_WIN_RATE_TOLERANCE=0.20
ETF_LIVE_DRIFT_MEAN_RETURN_TOLERANCE=0.03
ETF_LIVE_DRIFT_MIN_CLOSED_TRADES=10
