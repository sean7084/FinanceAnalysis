# Copy this file to .envs/.local for local development.
# Example:
#   mkdir -p .envs
#   cp .env.example .envs/.local

# GENERAL
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_DEBUG=True
DJANGO_READ_DOT_ENV_FILE=True

# DATABASE
DATABASE_URL=postgres://finance_analysis:finance_analysis@localhost:5432/finance_analysis

# CACHE / CHANNELS
REDIS_URL=redis://localhost:6379/1

# CELERY
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# DATA PROVIDER
TUSHARE_TOKEN=replace-with-your-tushare-token

# OPTIONAL HELPERS
SMOKE_USERNAME=
SMOKE_PASSWORD=