# Copy this file to .env for local development.
# PowerShell:
#   Copy-Item .env.example .env
# Bash:
#   cp .env.example .env

# GENERAL
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_DEBUG=True
DJANGO_READ_DOT_ENV_FILE=True

# DATABASE
# Replace 192.168.31.8 if your PostgreSQL host differs.
DATABASE_URL=postgres://finance_analysis:finance_analysis@192.168.31.8:5432/finance_analysis

# CACHE / CHANNELS
# Replace 192.168.31.8 if your Redis host differs.
REDIS_URL=redis://finance_analysis:finance_analysis@192.168.31.8:6379/1

# CELERY
CELERY_BROKER_URL=redis://finance_analysis:finance_analysis@192.168.31.8:6379/0
CELERY_RESULT_BACKEND=redis://finance_analysis:finance_analysis@192.168.31.8:6379/0

# DATA PROVIDER
TUSHARE_TOKEN=replace-with-your-tushare-token

# OPTIONAL HELPERS
SMOKE_USERNAME=
SMOKE_PASSWORD=